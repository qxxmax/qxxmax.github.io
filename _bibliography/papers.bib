@article{qian2026nhmc,
  abbr        = {arXiv},
  bibtex_show = {true},
  selected    = {true},
  topic       = {ml_boltzmann},
  title       = {Neural Non-Equilibrium Hamiltonian Monte Carlo for Corrected Boltzmann Sampling},
  author      = {Qian, Moxian},
  journal     = arxiv,
  year        = {2026},
  month       = {Jul},
  eprint      = {2607.15682},
  archivePrefix = {arXiv},
  primaryClass  = {cs.LG},
  arxiv       = {2607.15682},
  html        = {https://arxiv.org/abs/2607.15682},
  tldr        = {Learned stochastic Hamiltonian paths corrected by recorded non-equilibrium work through path-SNIS, path-IMH, or a proved shared-bridge round-trip Metropolis kernel. Tested on analytic many-well and finite-volume 2D phi^4 targets; molecular and compact U(1) studies retain explicit feasibility boundaries.},
  tldr_zh     = {用记录的非平衡功修正可学习的随机 Hamiltonian 路径，包括 path-SNIS、path-IMH 和经过证明的共享桥接点 round-trip Metropolis 核。已在解析多阱与有限体积二维 phi^4 上测试；分子和紧致 U(1) 研究保留明确的可行性边界。},
  feature_image = {nhmc-method-overview.png},
  feature_alt = {NHMC learned stochastic Hamiltonian path, recorded work, and four correction routes},
  feature_caption = {Figure 1. A learned stochastic Hamiltonian path records work that supports path-SNIS, free-energy estimation, path-IMH, and round-trip NHMC-MH.},
  feature_caption_zh = {图 1。可学习的随机 Hamiltonian 路径记录非平衡功，并由此连接 path-SNIS、自由能估计、path-IMH 和 round-trip NHMC-MH。},
  abstract    = {Sampling from an unnormalized Boltzmann density requires proposals that move probability mass globally while retaining enough path-probability information for statistical correction. We introduce Neural Non-Equilibrium Hamiltonian Monte Carlo (NHMC), a train-then-correct learned Hamiltonian sampler. Starting from a tractable base distribution, NHMC learns stochastic Hamiltonian-style paths toward the target. Once training is complete, the learned proposal parameters are fixed; the proposal then generates complete paths and endpoint configurations, which are statistically corrected using the recorded non-equilibrium work. This dimensionless generalized work is determined by the probability ratio between the forward proposal path and a reverse reference path. During training, minimizing its mean reduces a path-space KL divergence and controls an upper bound on endpoint mismatch. During evaluation, the same quantity defines weights for self-normalized importance sampling on paths (path-SNIS), estimates normalizing constants or free-energy differences, and gives the acceptance ratio for path-space independent Metropolis-Hastings (path-IMH). The same forward-reverse laws also define a shared-bridge round-trip Metropolis kernel that acts directly on configurations and preserves the Boltzmann target. On double-well and finite-volume lattice phi^4 targets, the NHMC construction gives corrected estimates when path overlap is sufficient; when overlap is poor, weight degeneracy, low acceptance, and long autocorrelation expose proposal failure. We additionally report a molecular internal-coordinate feasibility study using an MD prior and learned-force path proposal.}
}

@article{chen2026sps,
  abbr        = {arXiv},
  bibtex_show = {true},
  selected    = {true},
  topic       = {ml_boltzmann},
  title       = {Stochastic Path Sampler For Lattice Field Theory},
  author      = {Chen, Shiyang and Qian, Moxian and Aarts, Gert and Lucini, Biagio and Zhou, Kai},
  journal     = arxiv,
  year        = {2026},
  month       = {Jun},
  eprint      = {2606.13790},
  archivePrefix = {arXiv},
  primaryClass  = {hep-lat},
  arxiv       = {2606.13790},
  html        = {https://arxiv.org/abs/2606.13790},
  note        = {S. Chen and M. Qian contributed equally},
  tldr        = {A data-free neural sampler built from learnable forward/backward stochastic dynamics; matches HMC quality with much shorter autocorrelation near the pseudo-critical region of 2D phi^4.},
  tldr_zh     = {一种不需要训练数据的神经网络采样器，用可学习的前/后向随机动力学构造；在二维 phi^4 的赝临界区域，能匹配 HMC 的精度但自相关时间短得多。},
  feature_image = {sps-path-balance.png},
  feature_alt = {SPS forward and backward path measures between a known prior and the Boltzmann target},
  feature_caption = {Figure 1. Learned forward and backward path measures connect a known prior to the Boltzmann target; trajectory balance is the organizing principle.},
  feature_caption_zh = {图 1。可学习的前向与反向路径测度连接已知先验和 Boltzmann 目标分布，核心组织原则是轨迹层面的平衡。},
  abstract    = {In lattice field theory, target distributions are known only up to normalization, while the partition function is generally intractable. Markov chain Monte Carlo simulations often become inefficient near phase transitions or the continuum limit due to critical slowing down. We propose a novel sampler based on nonequilibrium thermodynamics, called Stochastic Path Sampler (SPS), which can generate configurations for the unnormalized target distribution without a need for training data. The central idea is to establish a trajectory-level balance for learnable forward and backward stochastic dynamics between two equilibrium states---the prior and target distributions---by minimizing the path-space variational free energy, equivalently an entropy-production upper bound. The learned forward process provides independent proposals, subsequently corrected by an extended-space Independence Metropolis--Hastings step. In two-dimensional phi^4 theory, our neural sampler matches HMC's sampling quality with a much shorter autocorrelation time in the pseudocritical region. SPS offers a stochastic-quantization-inspired route to data-free proposal construction for lattice field theory.}
}

@article{qian2025van,
  abbr        = {arXiv},
  bibtex_show = {true},
  selected    = {false},
  topic       = {ml_boltzmann},
  title       = {Variational Autoregressive Networks Applied to $\phi^4$ Field Theory Systems},
  author      = {Qian, Moxian and Chen, Shiyang},
  journal     = arxiv,
  year        = {2025},
  month       = {Dec},
  eprint      = {2512.19575},
  archivePrefix = {arXiv},
  primaryClass  = {hep-lat},
  arxiv       = {2512.19575},
  html        = {https://arxiv.org/abs/2512.19575},
  tldr        = {Trains autoregressive networks via reinforcement learning for data-free sampling on Ising and phi^4; small Metropolis-Hastings corrections on top of the network proposals reduce residual bias while keeping high sample efficiency.},
  tldr_zh     = {用强化学习训练自回归网络，对 Ising 与 phi^4 做无数据采样；在网络提议之上叠加小的 Metropolis-Hastings 修正，降低残余偏差同时保持高采样效率。},
  feature_image = {van-analytic-sampling-path.png},
  feature_alt = {Analytic VAN sampling path from a unimodal prior to a bimodal Gaussian-mixture target},
  feature_caption = {Figure 1. In an analytic two-dimensional Gaussian-mixture example, VAN samples s1 and then s2 conditional on s1, routing a unimodal prior into the two modes of the target.},
  feature_caption_zh = {图 1。在解析的二维 Gaussian-mixture 例子中，VAN 先采样 s1，再根据 s1 条件采样 s2，把单峰先验中的样本送入目标分布的两个模态。},
  feature_image_secondary = {van-block-mh-magnetization.png},
  feature_alt_secondary = {Magnetization comparison among HMC, VAN, VAN plus single-site MH, and VAN plus block MH},
  feature_caption_secondary = {Figure 5a. In the 2D phi^4 benchmark, VAN+Block MH follows the HMC magnetization curve where the uncorrected VAN shows residual bias.},
  feature_caption_secondary_zh = {图 5(a)。在二维 phi^4 基准中，未修正的 VAN 出现残余偏差，而 VAN+Block MH 的磁化强度结果重新贴近 HMC 曲线。},
  abstract    = {We combine reinforcement learning with variational autoregressive networks (VANs) to perform data-free training and sampling for the discrete Ising model and the continuous phi^4 scalar field theory. We quantify the complexity of the target distribution via the KL divergence between the magnetization distribution and a reference Gaussian distribution, and observe that configurations with smaller KL divergence typically require fewer training steps. Motivated by this observation, we investigate transfer learning and show that fine-tuning models pretrained at a single value of kappa can reduce training time compared with training from a Gaussian field. In addition, inspired by single-site and cluster Monte Carlo updates, we introduce single-site and block Metropolis-Hastings (MH) updates on top of VAN proposals. These MH corrections systematically reduce the residual bias of pure VAN sampling in the parameter range we study, while maintaining high sampling efficiency in terms of the effective sample size (ESS). For both the Ising model and the phi^4 theory, our results agree with standard Monte Carlo benchmarks within errors, and no clear critical slowing down is observed in the explored parameter ranges.}
}

@article{qian2026spectroscopy,
  abbr        = {arXiv},
  bibtex_show = {true},
  selected    = {true},
  topic       = {network_analysis},
  title       = {Operator Spectroscopy of Trained Lattice Samplers},
  author      = {Qian, Moxian},
  journal     = arxiv,
  year        = {2026},
  month       = {May},
  eprint      = {2605.11199},
  archivePrefix = {arXiv},
  primaryClass  = {hep-lat},
  arxiv       = {2605.11199},
  html        = {https://arxiv.org/abs/2605.11199},
  tldr        = {Instead of judging trained samplers only by the ensembles they produce, projects the learned field-space function onto symmetry-fixed operator bases — revealing what different sampler families (flow-matching, diffusion, normalizing flows, gauge-equivariant) actually learn.},
  tldr_zh     = {不再只看采样器产生的 ensemble，而是把训练后的场空间函数投影到事先按对称性固定好的算符基上 —— 由此看清楚 flow matching、diffusion、normalizing flow、规范等变这几类采样器到底学到了什么。},
  abstract    = {Trained lattice samplers are usually judged by the ensembles they generate. Here we instead analyze the trained field-space function itself: a flow-matching velocity, a diffusion score, or a normalizing-flow action residual. We project these functions onto operator bases fixed before the fit, chosen from symmetry, exact Gaussian path limits, finite-volume modes, and gauge covariance. For two-dimensional lattice phi^4, a trained straight-flow teacher is not described by a local force basis alone. After the local transport basis, the residual separates into a zero-mode Binder component and a lowest-shell finite-k correlator component. The same projection also distinguishes other sampler classes: diffusion follows the force-resolvent ordering predicted by the free theory, reverse-KL normalizing-flow collapse appears as a forbidden odd zero-mode residual, and gauge-equivariant teachers are resolved by Wilson-loop-force tangent directions.}
}

